{
  "cleanUrls": false,
  "trailingSlash": false,
  "functions": {
    "api/pagina.js": {
      "includeFiles": "index.html"
    },
    "api/sincronizar.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/pedido",
      "destination": "/api/tienda?a=pedido"
    },
    {
      "source": "/api/cupon",
      "destination": "/api/tienda?a=cupon"
    },
    {
      "source": "/api/factura",
      "destination": "/api/tienda?a=factura"
    },
    {
      "source": "/api/estado-pagos",
      "destination": "/api/tienda?a=estado-pagos"
    },
    {
      "source": "/api/cuenta",
      "destination": "/api/tienda?a=cuenta"
    },
    {
      "source": "/api/aviso-prueba",
      "destination": "/api/admin?a=aviso-prueba"
    },
    {
      "source": "/api/indexnow",
      "destination": "/api/admin?a=indexnow"
    },
    {
      "source": "/api/admin-pedido",
      "destination": "/api/admin?a=admin-pedido"
    },
    {
      "source": "/api/imagen",
      "destination": "/api/admin?a=imagen"
    },
    {
      "source": "/api/leer",
      "destination": "/api/admin?a=leer"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/feed.xml",
      "destination": "/api/feed"
    },
    {
      "source": "/producto/:clave",
      "destination": "/api/pagina?t=producto&k=:clave"
    },
    {
      "source": "/coleccion/:clave",
      "destination": "/api/pagina?t=coleccion&k=:clave"
    },
    {
      "source": "/info/:clave",
      "destination": "/api/pagina?t=info&k=:clave"
    },
    {
      "source": "/carrito",
      "destination": "/api/pagina?t=carrito"
    },
    {
      "source": "/cuenta",
      "destination": "/api/pagina?t=cuenta"
    },
    {
      "source": "/gracias",
      "destination": "/api/pagina?t=gracias"
    },
    {
      "source": "/buscar",
      "destination": "/api/pagina?t=buscar"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": ".*\\.vercel\\.app"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/admin(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000"
        }
      ]
    },
    {
      "source": "/sw-admin.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/admin"
        }
      ]
    },
    {
      "source": "/admin.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        }
      ]
    }
  ],
  "images": {
    "sizes": [
      384,
      640,
      1080
    ],
    "formats": [
      "image/webp"
    ],
    "minimumCacheTTL": 2592000,
    "remotePatterns": [
      {
        "protocol": "https",
        "hostname": "ajvbndzdkikacliqzjot.supabase.co"
      },
      {
        "protocol": "https",
        "hostname": "cdn.shopify.com"
      }
    ]
  },
  "crons": [
    {
      "path": "/api/sincronizar",
      "schedule": "0 5 * * *"
    }
  ]
}
